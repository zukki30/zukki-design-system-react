{
  "name": "zukki-design-system",
  "private": true,
  "version": "3.0.0",
  "description": "デザインシステム",
  "scripts": {
    "dev": "pnpm storybook",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "build:tokens:css-only": "tsx style-dictionary/build-css-only-variables-to-files.ts",
    "build:tokens:css": "tsx style-dictionary/build-css-variables-to-files.ts",
    "build:tokens:ts-object": "tsx style-dictionary/build-css-variables-ts-object.ts",
    "build:tokens": "pnpm build:tokens:css-only && pnpm build:tokens:css && pnpm build:tokens:ts-object && pnpm format",
    "token:transform:light": "token-transformer ./figma/tokens.json ./style-dictionary/tokens/light.json --expandTypography=true --expandShadow=true PrimitiveColor/light,ThemeColor/light,SemanticColor/light",
    "token:transform:dark": "token-transformer ./figma/tokens.json ./style-dictionary/tokens/dark.json --expandTypography=true --expandShadow=true PrimitiveColor/dark,ThemeColor/dark,SemanticColor/dark",
    "token:transform:typography": "token-transformer ./figma/tokens.json ./style-dictionary/tokens/typography.json --expandTypography=true --expandShadow=true Typography/value",
    "token:transform:other": "token-transformer ./figma/tokens.json ./style-dictionary/tokens/token.json --expandTypography=true --expandShadow=true global,Token/value",
    "token:transform": "pnpm token:transform:light && pnpm token:transform:dark && pnpm token:transform:typography && pnpm token:transform:other",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:ui": "vitest --ui --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:a11y": "vitest run --project a11y-light --project a11y-dark"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "style-dictionary": "^5.5.2",
    "token-transformer": "^0.0.33",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "style-dictionary"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
