{
  // 配布する型宣言を出力するための設定。
  // typecheck（tsc -b）の経路は変えず、vite-plugin-dts からのみ参照する
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // declarationMap は出さない。参照先の src を配布物に含めないため、
    // 出しても利用側からは全てリンク切れになる
    "declarationMap": false,
    // テスト用のグローバル型を配布物の型に混ぜない
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.stories.tsx"]
}
